///////////////////////////////////////////////////////////////////////////////
// Meta
livedebugging {
    // WARN: Disable livedebugging on production!
    enabled = true
}

///////////////////////////////////////////////////////////////////////////////
// Instrument Alloy
// https://grafana.com/docs/alloy/latest/collect/metamonitoring/

//logging {
    //level  = "info"
    //format = "logfmt"
//}

logging {
  level    = "info"
  format   = "json"
  write_to = [loki.write.default.receiver]
  //write_to = [otelcol.receiver.loki.default.receiver]
}

//otelcol.receiver.loki "default" {
  //output {
    //logs = [otelcol.processor.batch.default.input]
  //}
//}

loki.write "default" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}

prometheus.exporter.self "alloy" {
}

prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [otelcol.receiver.prometheus.default.receiver]
  scrape_interval = "10s"
}

otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

tracing {
  sampling_fraction = 0.01
  write_to = [otelcol.processor.batch.default.input]
}

///////////////////////////////////////////////////////////////////////////////
// Configuration file
local.file "endpoints" {
    // The endpoints file is used to define the endpoints, credentials and options
    // for the Alloy export to.
    filename = "/etc/alloy/endpoints.json"
}

///////////////////////////////////////////////////////////////////////////////
// Receiver

// The OpenTelemetry receiver is used to ingest all incoming logs, metrics, and trace spans.
// Note that both the instrumented applications and Beyla use the same receiver to send traces.
otelcol.receiver.otlp "default" {
    // We don't technically need this, but it shows how to change listen address and incoming port.
    // In this case, the Alloy is listening on all available bindable addresses on port 4317 (which is the
    // default OTLP gRPC port) for the OTLP protocol.
    grpc {
        endpoint = "0.0.0.0:4317"
    }

    http {
        endpoint = "0.0.0.0:4318"
    }

    output {
        logs       = [otelcol.processor.batch.default.input]
        metrics    = [otelcol.processor.batch.default.input]
        traces     = [otelcol.processor.batch.default.input]

        // We define where to send the output of all ingested traces. In this case, to the OpenTelemetry batch processor
        // named 'default'.
        // traces = [
            // Uncomment the next line to generate service graph metrics from the Alloy. By default this is generated
            // by the Tempo component, so be sure to remove the relevant configuration in the `tempo/tempo.yaml` file.
            //otelcol.connector.servicegraph.tracemetrics.input,

            // Uncomment the next line to generate span metrics from the Alloy. By default this is generated
            // by the Tempo component, so be sure to remove the relevant configuration in the `tempo/tempo.yaml` file.
            //otelcol.connector.spanmetrics.tracemetrics.input,

            // The following would be used for tail sampling only traces containing errors.
            // Uncomment the following line, then comment out the line below it (the batch processor) to use
            // tail sampling.
            //otelcol.processor.tail_sampling.errors.input,

            //otelcol.connector.spanlogs.autologging.input,
        // ]
    }
}

///////////////////////////////////////////////////////////////////////////////
// Processors

// The OpenTelemetry batch processor collects trace spans until a batch size or
// timeout is met, before sending those spans onto another target.
// https://grafana.com/docs/agent/latest/flow/reference/components/otelcol.processor.batch
otelcol.processor.batch "default" {
    // Wait until we've received 1000 samples, up to a maximum of 2000
    send_batch_size = 1000
    send_batch_max_size = 2000
    // Or until 2 seconds have elapsed
    timeout = "2s"

    // Forwards events when Alloy has batched enough data
    output {
        logs    = [otelcol.exporter.otlphttp.loki.input]
        metrics = [otelcol.processor.deltatocumulative.default.input]
        // metrics = [otelcol.processor.attributes.alter_metrics_labels.input]
        traces  = [otelcol.exporter.otlphttp.tempo.input]
        // logs    = [otelcol.processor.resourcedetection.default.input]
        // metrics = [otelcol.processor.resourcedetection.default.input]
        // traces  = [otelcol.processor.resourcedetection.default.input]
    }
}

// The OpenTelemetry resource detector automatically detects configured
// resources and attaches those details to the OTEL events
// TODO: Remove this component when it becomes possible to configure
// "service.instance.id" directly via opentelemetry-php SDK.
// NOTE: We are using this component to override the "service.instance.id"
// resource attribute. The opentelemetry-php SDK does not respect the
// OTEL_RESOURCE_ATTRIBUTES=service.instance.id=xyz environment variable and
// always sets the service.instance.id = UUIDv4 on each request. So the
// cardinality of the "instance" label in metrics becomes too high. Hence we
// are overriding this attribute's value using the OTEL_RESOURCE_ATTRIBUTES env
// variable set in Alloy's container (via entrypoint.sh).
otelcol.processor.resourcedetection "default" {
    // The env detector reads resource information from the
    // OTEL_RESOURCE_ATTRIBUTES environment variable.
    // This variable must be in the format <key1>=<value1>,<key2>=<value2>,...
    detectors = ["env"]

    output {
        logs    = [otelcol.exporter.otlphttp.loki.input]
        metrics = [otelcol.processor.deltatocumulative.default.input]
        // metrics = [otelcol.processor.attributes.alter_metrics_labels.input]
        traces  = [otelcol.exporter.otlphttp.tempo.input]
    }
}

// Then OpenTelemetry attributes component can alter attributes values
otelcol.processor.attributes "alter_metrics_labels" {
    // WARN: We attach the instance_id of alloy as a label in all metrics to
    // ensure restarting alloy does not reset the counter. This is a CRITICAL
    // step.
    // This is currently not being used because the
    // otelcol.processor.resourcedetection.default component already sets the
    // service.instance.id to the Alloy's instance id. So there is no need for
    // duplicate labels without purpose. But this will need to be enabled when
    // we have multiple different service instances sending their events to the
    // same alloy receiver.
    action {
        key = "alloy_instance_id"
        action = "upsert"
        value = sys.env("INSTANCE_ID")
    }

    output {
        metrics = [otelcol.processor.deltatocumulative.default.input]
    }
}

// Convert delta temporality metrics to cumulative temporality
// https://grafana.com/blog/2023/09/26/opentelemetry-metrics-a-guide-to-delta-vs.-cumulative-temporality-trade-offs/
otelcol.processor.deltatocumulative "default" {
    output {
        metrics = [otelcol.exporter.otlphttp.mimir.input]
    }
}

///////////////////////////////////////////////////////////////////////////////
// Exporters

// Send logs to the OpenTelemetry exporter named 'loki' via OTLP HTTP protocol
otelcol.exporter.otlphttp "loki" {
    client {
        // client.endpoint is used to construct the logs endpoint as follows: client.endpoint + "/v1/logs"
        // So, logs_endpoint here would be "http://loki:3100/otlp/v1/logs"
        // https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#arguments
        endpoint = "http://loki:3100/otlp"
    }
}

// Send metrics to the OpenTelemetry exporter named 'mimir' via OTLP HTTP protocol
otelcol.exporter.otlphttp "mimir" {
    client {
        // client.endpoint is used to construct the metrics endpoint as follows: client.endpoint + "/v1/metrics"
        // So, metrics_endpoint here would be "http://mimir:9009/otlp/v1/metrics"
        // https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#arguments
        endpoint = "http://mimir:9009/otlp"
    }
}

// Send traces to the OpenTelemetry exporter named 'tempo' via OTLP HTTP protocol
otelcol.exporter.otlphttp "tempo" {
    client {
        // client.endpoint is used to construct the traces endpoint as follows: client.endpoint + "/v1/traces"
        // So, traces_endpoint here would be "http://tempo:4318/otlp/v1/traces"
        // https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#arguments
        endpoint = "http://tempo:4318/otlp"
    }
}

// otelcol.exporter.otlp "loki" {
//     client {
//         // client.endpoint is used to construct the logs endpoint as follows: client.endpoint + "/v1/logs"
//         // So, logs_endpoint here would be "http://loki:3100/otlp/v1/logs"
//         // https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#arguments
//         endpoint = "http://loki:9095"
//     }
// }

// otelcol.exporter.otlphttp "tempo_cloud" {
//     client {
//         // client.endpoint is used to construct the traces endpoint as follows: client.endpoint + "/v1/traces"
//         // So, traces_endpoint here would be "http://tempo:3200/otlp/v1/traces"
//         // https://grafana.com/docs/alloy/latest/reference/components/otelcol/otelcol.exporter.otlphttp/#arguments
//         //endpoint = "http://tempo:3200/otlp"
//         endpoint = json_path(local.file.endpoints.content, ".traces_cloud.url")[0]
//         auth     = otelcol.auth.basic.grafana_cloud.handler
//     }
// }

// otelcol.auth.basic "grafana_cloud" {
//     username = json_path(local.file.endpoints.content, ".traces_cloud.basicAuth.username")[0]
//     password = json_path(local.file.endpoints.content, ".traces_cloud.basicAuth.password")[0]
// }

// The OpenTelemetry exporter exports processed trace spans to another target that is listening for OTLP format traces.
// A unique label, 'tempo', is added to uniquely identify this exporter.
otelcol.exporter.otlp "tempo" {
    // Define the client for exporting.
    client {
        // Authentication block.
        auth = otelcol.auth.headers.tempo.handler

        // Send to the locally running Tempo instance, on port 4317 (OTLP gRPC).
        endpoint = json_path(local.file.endpoints.content, ".traces.url")[0]

        // Configure TLS settings for communicating with the endpoint.
        tls {
            // The connection is insecure.
            insecure = json_path(local.file.endpoints.content, ".traces.tls.insecure")[0]
            // Do not verify TLS certificates when connecting.
            insecure_skip_verify = json_path(local.file.endpoints.content, ".traces.tls.insecureSkipVerify")[0]
        }
    }
}

// The OpenTelemetry auth headers component is used to define the headers for the OTLP exporter. Note we don't
// use basic auth here because the OTel spec. demands TLS enabled for basic auth. Using basic header auth
// allow us to still wire up the basic auth credentials to the Tempo exporter even when they won't be required.
otelcol.auth.headers "tempo" {
    header {
        key = "Authorization"
        value = join(["Basic ", json_path(local.file.endpoints.content, ".traces.basicAuthToken")[0]], "")
    }
}


// Monitor Grafana metrics
// https://grafana.com/docs/grafana/latest/setup-grafana/set-up-grafana-monitoring/
prometheus.scrape "grafana" {
	targets = [{"__address__" = "grafana:3000"}]
  forward_to = [otelcol.receiver.prometheus.default.receiver]
  scrape_interval = "10s"
}

// Monitor Loki metrics
// https://grafana.com/docs/loki/latest/operations/meta-monitoring/mixins/
// https://github.com/grafana/loki/tree/main/production/loki-mixin-compiled
// TODO: Import rules.yml and alerts.yml via mimirtool as mentioned in the above link
// https://grafana.com/docs/mimir/latest/manage/tools/mimirtool/
prometheus.scrape "loki" {
	targets = [{"__address__" = "loki:3100"}]
  forward_to = [otelcol.receiver.prometheus.default.receiver]
  scrape_interval = "10s"
}

// Monitor Mimir metrics
// https://grafana.com/docs/mimir/latest/manage/monitor-grafana-mimir/installing-dashboards-and-alerts/
// https://github.com/grafana/mimir/tree/main/operations/mimir-mixin-compiled
// TODO: Import rules.yml and alerts.yml via mimirtool as mentioned in the above link
// https://grafana.com/docs/mimir/latest/manage/tools/mimirtool/
prometheus.scrape "mimir" {
	targets = [{"__address__" = "mimir:9009"}]
  forward_to = [otelcol.receiver.prometheus.default.receiver]
  scrape_interval = "10s"
}

// Monitor Tempo metrics
// https://grafana.com/docs/tempo/latest/operations/monitor/
// https://github.com/grafana/tempo/tree/main/operations/tempo-mixin-compiled
// TODO: Import rules.yml and alerts.yml via mimirtool as mentioned in the above link
// https://grafana.com/docs/mimir/latest/manage/tools/mimirtool/
prometheus.scrape "tempo" {
	targets = [{"__address__" = "tempo:3200"}]
  forward_to = [otelcol.receiver.prometheus.default.receiver]
  scrape_interval = "10s"
}
